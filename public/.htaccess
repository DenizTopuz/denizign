# Denizign: static site on Apache/LiteSpeed hosting.

# HTTPS and one canonical host (denizign.nl, no www).
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://denizign.nl%{REQUEST_URI} [L,R=301]

# Pretty URLs: /about -> /about/index.html
DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
